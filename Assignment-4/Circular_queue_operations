#include <iostream>
using namespace std;

#define SIZE 5

int q[SIZE], front = -1, rear = -1;

bool isEmpty() {
    return front == -1;
}

bool isFull() {
    return (rear + 1) % SIZE == front;
}

void enqueue(int x) {
    if (isFull()) {
        cout << "Queue Overflow\n";
        return;
    }

    if (isEmpty()) front = 0;
    rear = (rear + 1) % SIZE;
    q[rear] = x;
}

void dequeue() {
    if (isEmpty()) {
        cout << "Queue Underflow\n";
        return;
    }

    cout << "Deleted: " << q[front] << "\n";

    if (front == rear)
        front = rear = -1;
    else
        front = (front + 1) % SIZE;
}

void peek() {
    if (isEmpty()) cout << "Queue is empty\n";
    else cout << "Front: " << q[front] << "\n";
}

void display() {
    if (isEmpty()) {
        cout << "Queue is empty\n";
        return;
    }

    int i = front;
    while (true) {
        cout << q[i] << " ";
        if (i == rear) break;
        i = (i + 1) % SIZE;
    }
    cout << "\n";
}

int main() {
    int ch, x;
    do {
        cout << "Menu\n 1.Enqueue\n 2.Dequeue\n 3.isEmpty\n"
             << " 4.isFull\n 5.Display\n 6.Peek\n 0.Exit\n";
        cin >> ch;

        switch (ch) {
            case 1:
                cin >> x;
                enqueue(x);
                break;
            case 2: dequeue(); break;
            case 3: cout << (isEmpty() ? "Yes" : "No") << "\n"; break;
            case 4: cout << (isFull() ? "Yes" : "No") << "\n"; break;
            case 5: display(); break;
            case 6: peek(); break;
        }
    } while (ch != 0);

    return 0;
}